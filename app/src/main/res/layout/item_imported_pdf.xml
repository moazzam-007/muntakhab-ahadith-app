<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_small"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- PDF name -->
        <TextView
            android:id="@+id/tv_pdf_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Last seen page (hidden if never opened) -->
        <TextView
            android:id="@+id/tv_last_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            android:visibility="gone" />

        <!-- Progress bar + percentage row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_small">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/progress_bar_height"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/progress_color"
                android:progressBackgroundTint="@color/progress_track" />

            <TextView
                android:id="@+id/tv_pdf_progress"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_small"
                android:gravity="end"
                android:text="0%" />
        </LinearLayout>

        <!-- Delete button -->
        <Button
            android:id="@+id/btn_delete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:text="@string/action_delete"
            android:textColor="@color/error_red"
            android:minHeight="@dimen/touch_target_min" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
