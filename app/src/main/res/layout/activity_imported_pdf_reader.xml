<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:titleTextColor="@color/on_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Page indicator bar -->
    <TextView
        android:id="@+id/tv_page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_small"
        android:background="@color/surface"
        android:elevation="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_small"
        android:gravity="center"
        android:text="@string/loading_pdf" />

    <!-- PDF Viewer -->
    <com.rajat.pdfviewer.PdfRendererView
        android:id="@+id/pdf_renderer_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Save button at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_small"
        android:background="@color/surface"
        android:elevation="4dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_save_last_seen"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/btn_save_last_seen"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary" />
    </LinearLayout>

</LinearLayout>
