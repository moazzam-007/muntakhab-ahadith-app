<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:titleTextColor="@color/on_primary"
            app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">



            <!-- ══════════════════════════════════════════════════ -->
            <!--   YOUR PROGRESS CARD                              -->
            <!-- ══════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:text="@string/title_your_progress"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12" />

                    <!-- Kalimah row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_small">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1.3" android:text="@string/section_kalimah"
                            android:textColor="@color/text_primary" android:textSize="@dimen/text_size_caption" />
                        <ProgressBar android:id="@+id/progress_kalimah"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="@dimen/progress_bar_height"
                            android:layout_weight="1.5" android:layout_marginStart="@dimen/spacing_small"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:max="100" android:progress="0"
                            android:progressTint="@color/progress_color"
                            android:progressBackgroundTint="@color/progress_track" />
                        <TextView android:id="@+id/tv_progress_pct_kalimah"
                            android:layout_width="36dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_small" android:gravity="end" />
                    </LinearLayout>

                    <!-- Salah row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_small">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1.3" android:text="@string/section_salah"
                            android:textColor="@color/text_primary" android:textSize="@dimen/text_size_caption" />
                        <ProgressBar android:id="@+id/progress_salah"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="@dimen/progress_bar_height"
                            android:layout_weight="1.5" android:layout_marginStart="@dimen/spacing_small"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:max="100" android:progress="0"
                            android:progressTint="@color/progress_color"
                            android:progressBackgroundTint="@color/progress_track" />
                        <TextView android:id="@+id/tv_progress_pct_salah"
                            android:layout_width="36dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_small" android:gravity="end" />
                    </LinearLayout>

                    <!-- Ilm and Zikr row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_small">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1.3" android:text="@string/section_ilm_zikr"
                            android:textColor="@color/text_primary" android:textSize="@dimen/text_size_caption" />
                        <ProgressBar android:id="@+id/progress_ilm_zikr"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="@dimen/progress_bar_height"
                            android:layout_weight="1.5" android:layout_marginStart="@dimen/spacing_small"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:max="100" android:progress="0"
                            android:progressTint="@color/progress_color"
                            android:progressBackgroundTint="@color/progress_track" />
                        <TextView android:id="@+id/tv_progress_pct_ilm_zikr"
                            android:layout_width="36dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_small" android:gravity="end" />
                    </LinearLayout>

                    <!-- Ikram-e-Muslim row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_small">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1.3" android:text="@string/section_ikram"
                            android:textColor="@color/text_primary" android:textSize="@dimen/text_size_caption" />
                        <ProgressBar android:id="@+id/progress_ikram"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="@dimen/progress_bar_height"
                            android:layout_weight="1.5" android:layout_marginStart="@dimen/spacing_small"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:max="100" android:progress="0"
                            android:progressTint="@color/progress_color"
                            android:progressBackgroundTint="@color/progress_track" />
                        <TextView android:id="@+id/tv_progress_pct_ikram"
                            android:layout_width="36dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_small" android:gravity="end" />
                    </LinearLayout>

                    <!-- Ikhlas-e-Niyyat row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_small">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1.3" android:text="@string/section_ikhlas"
                            android:textColor="@color/text_primary" android:textSize="@dimen/text_size_caption" />
                        <ProgressBar android:id="@+id/progress_ikhlas"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="@dimen/progress_bar_height"
                            android:layout_weight="1.5" android:layout_marginStart="@dimen/spacing_small"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:max="100" android:progress="0"
                            android:progressTint="@color/progress_color"
                            android:progressBackgroundTint="@color/progress_track" />
                        <TextView android:id="@+id/tv_progress_pct_ikhlas"
                            android:layout_width="36dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_small" android:gravity="end" />
                    </LinearLayout>

                    <!-- Dawat wa Tabligh row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1.3" android:text="@string/section_dawat"
                            android:textColor="@color/text_primary" android:textSize="@dimen/text_size_caption" />
                        <ProgressBar android:id="@+id/progress_dawat"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp" android:layout_height="@dimen/progress_bar_height"
                            android:layout_weight="1.5" android:layout_marginStart="@dimen/spacing_small"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:max="100" android:progress="0"
                            android:progressTint="@color/progress_color"
                            android:progressBackgroundTint="@color/progress_track" />
                        <TextView android:id="@+id/tv_progress_pct_dawat"
                            android:layout_width="36dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_small" android:gravity="end" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!--   SIX QUALITIES – SECTION BUTTONS                 -->
            <!-- ══════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:text="@string/title_six_qualities"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12" />

                    <Button
                        android:id="@+id/btn_kalimah"
                        style="@style/Widget.MuntakhabAhadith.SectionButton"
                        android:text="@string/section_kalimah"
                        android:contentDescription="@string/section_kalimah" />

                    <Button
                        android:id="@+id/btn_salah"
                        style="@style/Widget.MuntakhabAhadith.SectionButton"
                        android:text="@string/section_salah"
                        android:contentDescription="@string/section_salah" />

                    <Button
                        android:id="@+id/btn_ilm_zikr"
                        style="@style/Widget.MuntakhabAhadith.SectionButton"
                        android:text="@string/section_ilm_zikr"
                        android:contentDescription="@string/section_ilm_zikr" />

                    <Button
                        android:id="@+id/btn_ikram"
                        style="@style/Widget.MuntakhabAhadith.SectionButton"
                        android:text="@string/section_ikram"
                        android:contentDescription="@string/section_ikram" />

                    <Button
                        android:id="@+id/btn_ikhlas"
                        style="@style/Widget.MuntakhabAhadith.SectionButton"
                        android:text="@string/section_ikhlas"
                        android:contentDescription="@string/section_ikhlas" />

                    <Button
                        android:id="@+id/btn_dawat"
                        style="@style/Widget.MuntakhabAhadith.SectionButton"
                        android:text="@string/section_dawat"
                        android:contentDescription="@string/section_dawat" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!--   PDF LIBRARY BUTTON                              -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pdf_library"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/section_button_height"
                android:layout_marginBottom="@dimen/spacing_large"
                android:text="@string/btn_pdf_library"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:iconTint="@color/primary" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
